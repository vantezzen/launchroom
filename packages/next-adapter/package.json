{
  "name": "@vantezzen/launchroom-next-adapter",
  "version": "0.1.0",
  "description": "Next.js deployment adapter for launchroom: standalone output, deploymentId, static assets and a build manifest.",
  "license": "MIT",
  "author": "vantezzen",
  "homepage": "https://launchroom.vantezzen.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vantezzen/launchroom.git",
    "directory": "packages/next-adapter"
  },
  "keywords": [
    "nextjs",
    "next-adapter",
    "deployment-adapter",
    "launchroom",
    "self-hosted"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./finalize": {
      "types": "./dist/finalize.d.ts",
      "default": "./dist/finalize.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "launchroom-next-finalize": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "next": ">=16.2.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-reporter=spec 'test/*.test.ts'",
    "prepack": "npm run build"
  }
}
