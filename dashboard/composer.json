{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "vantezzen/launchroom-dashboard",
    "type": "project",
    "description": "launchroom control plane (Laravel + Inertia + React).",
    "keywords": [
        "launchroom",
        "paas",
        "self-hosted"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "anthropic-ai/sdk": "^0.59",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.50",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "lcobucci/jwt": "^5.6",
        "opis/json-schema": "^2.4",
        "phpseclib/phpseclib": "^4.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-typescript-transformer": "^3.3",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "rector/rector": "^2.7",
        "spaze/phpstan-disallowed-calls": "^4.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan launchroom:keys:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel --max-processes=4"
        ],
        "lint:check": [
            "pint --parallel --max-processes=4 --test"
        ],
        "rector": [
            "rector"
        ],
        "rector:check": [
            "rector --dry-run"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=1G"
        ],
        "types:generate": [
            "@php artisan typescript:transform"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "pest --parallel --processes=${LR_TEST_PROCESSES:-4}"
        ],
        "ci:static": [
            "Composer\\Config::disableProcessTimeout",
            "@lint:check",
            "@rector:check",
            "@types:check",
            "npm run check",
            "npm run types:check"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@ci:static",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.1"
        },
        "//": "composer audit reports abandoned packages without failing: symplify/rule-doc-generator-contracts (no replacement) is a dev-only transitive dependency of driftingly/rector-laravel. Security advisories still fail the audit.",
        "policy": {
            "abandoned": {
                "audit": "report"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "lint": "Fix code style with Pint",
        "lint:check": "Check code style with Pint",
        "rector": "Apply Rector refactorings",
        "rector:check": "Check that Rector has nothing to change",
        "types:check": "Run PHPStan (Larastan, level max, disallowed calls)",
        "types:generate": "Generate resources/js/types/generated.d.ts from Data classes and enums",
        "test": "Run the Pest suite in parallel (LR_TEST_PROCESSES workers, default 4; each gets its own <database>_test_<n> Postgres database)",
        "ci:static": "Run the static CI checks: Pint, Rector, PHPStan, vp check, tsc",
        "ci:check": "Run every CI check: the static checks, then Pest"
    }
}
