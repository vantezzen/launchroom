APP_NAME=launchroom
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Comma-separated list of previous APP_KEYs, used during APP_KEY rotation (docs/09 R13).
APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres is the only supported database (docs/07-data-model.md).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=launchroom
DB_USERNAME=launchroom
DB_PASSWORD=

# Valkey (Redis protocol) backs sessions, cache, queues (Horizon) and broadcasting.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb (WebSockets: "poll now" nudges and live log streams).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Sanctum API tokens always expire (docs/09 R11). Minutes; default 30 days.
SANCTUM_TOKEN_EXPIRATION=43200

# launchroom
# Key-encryption key file for envelope encryption (docs/09 R13). Create it with
# `php artisan launchroom:keys:generate`. Never the same as APP_KEY.
# Defaults to storage/keys/kek.key when unset.
# LAUNCHROOM_KEK_PATH=/data/keys/kek
# Comma-separated e-mail addresses of instance owners (Horizon dashboard access
# outside local). Placeholder until teams/roles land.
LAUNCHROOM_INSTANCE_OWNERS=
