{
    "name": "launchroom/laravel-sqlite",
    "description": "A Laravel app written for SQLite (docs/04 §3.1): no ext-pdo_pgsql in composer.json.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
