# launchroom dev stack settings. `make up` copies this to dev/.env (git-ignored)
# on first run; edit dev/.env to change ports when they clash with your own
# services. All host ports bind to 127.0.0.1 only.

# Dashboard (FrankenPHP) → http://localhost:8000
LR_DEV_DASHBOARD_PORT=8000
# Vite dev server + HMR (host and container port are kept identical)
LR_DEV_VITE_PORT=5173
# Reverb WebSocket server
LR_DEV_REVERB_PORT=6001
# Mailpit web UI → http://localhost:8025
LR_DEV_MAILPIT_PORT=8025
# Postgres, for a local DB GUI (user/password/db: launchroom, dev-only)
LR_DEV_POSTGRES_PORT=54320
# server-1's ingress (launchroomd's Caddy): apps on http(s)://*.localhost:8080 / :8443
LR_DEV_HTTP_PORT=8080
LR_DEV_HTTPS_PORT=8443
# The dev Forgejo (profile forgejo, `make up-forgejo`) → http://localhost:3300
LR_DEV_FORGEJO_PORT=3300
# The public website (make site-dev / site-preview) → http://localhost:3200
LR_DEV_SITE_PORT=3200

# UID/GID of the non-root user inside the dev images. The Makefile sets these to
# your `id -u` / `id -g` automatically; only set them here to override.
# LR_DEV_UID=1000
# LR_DEV_GID=1000

# Control-plane public key pinned by the fake servers' daemons (LR_CP_KEY).
# Empty until the dashboard has generated its signing key.
LR_DEV_CP_KEY=

# Extra flags for the fake servers' nested dockerd, e.g.
# LR_DEV_DOCKERD_ARGS=--insecure-registry=zot:5000
LR_DEV_DOCKERD_ARGS=
