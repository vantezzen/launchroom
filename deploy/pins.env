# Pins of the images and tools launchroom is built, tested and developed with
# (docs/09 R31). The runtime images a release installs are pinned in
# deploy/control-plane/images.env; this file holds everything else.
#
# Read by the Makefile and dev/bin/compose.sh (dev/compose.yml interpolates
# them), deploy/test/lib.sh and dev/go/fetch-restic.sh. Copies that cannot
# read this file (Dockerfile ARG defaults, Go tests, PHP config, templates, CI
# workflows) are listed in deploy/release/check-pins.sh, which fails when one
# differs (make lint-deploy).
#
# Plain KEY=VALUE: no quotes, no spaces (make, sh and compose read it).

# Go toolchain (golang:1.27): the dev Go container and launchroomd's image build.
LR_GO_IMAGE=golang:1.27@sha256:820153096fda4de6ac1b7194d12e416b7dd8f4e9a33d17e0345b111b945162d8
# docker:29-dind: dev fake servers and the e2e "VPS" containers.
LR_DIND_IMAGE=docker:29-dind@sha256:3e5756e2b6dad6a5f1f5deacf0a19f9eaa2581b76ae092b2d4a118162e1d4d4e
# docker:29-dind-rootless: the rootless integration tests (D49).
LR_DIND_ROOTLESS_IMAGE=docker:29-dind-rootless@sha256:825e451c9bd898245ca8fb07bd9a48999ccf33c0192fd68594c73aed7b67d11f
# versitygw v1.9.0: the S3 target of the dev stack, e2e tests and the template.
LR_VERSITYGW_IMAGE=docker.io/versity/versitygw@sha256:eb7f786fcd91e72194e48fcf1ac16302d686bf8e3a71434bdbc067a6efd3fdc7
# registry:3.1.2: the release registry of the update tests.
LR_REGISTRY_IMAGE=docker.io/library/registry@sha256:ddf754342cfc8acc51a56d5d0ab6af06826461864460636d8bd5c546dab2a7b8
# alpine/socat: the move e2e's mesh login address.
LR_SOCAT_IMAGE=alpine/socat@sha256:beb4a68d9e4fe6b0f21ea774a0fde6c31f580dde6368939ed70100c5385b015e
# Forgejo 11 (rootless): the dev git provider (docs/19 §8).
LR_FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:11-rootless@sha256:f7c2234b9ef3115c00f0b6dc6d2d0923171ab7785995f83ca70fb132b81b79e0
# caddy:2.11.7: stock Caddy, the base of launchroom-caddy and the edge of
# servers without it (daemon/internal/policy StockCaddyImageDigest).
LR_STOCK_CADDY_IMAGE=docker.io/library/caddy:2.11.7@sha256:685ae3d7c34d9b5f8caeddc5d14051db7bbd88ff1f5a2fa0c16bd8ca328fb7af
# busybox: script tests and lints, and the files helper image (policy FilesImageDigest).
LR_BUSYBOX_IMAGE=busybox@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e
LR_SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d
LR_ACTIONLINT_IMAGE=rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
# Go linters of make lint-daemon/lint-cli (image golangci/golangci-lint:<version>)
# and the CI jobs daemon-lint and cli.
LR_GOLANGCI_LINT_VERSION=v2.15.0
LR_GOVULNCHECK_VERSION=v1.9.0

# restic (docs/14 §2), a checksum-verified release binary in launchroomd's and
# the dashboard's images and next to the dev launchroomd.
LR_RESTIC_VERSION=0.19.1
LR_RESTIC_SHA256_AMD64=f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c
LR_RESTIC_SHA256_ARM64=a5f64aaab53d51e311fa3829124c5b703f2d14cf187d8640b6be3b2b49376465
