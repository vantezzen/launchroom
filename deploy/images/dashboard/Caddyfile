# FrankenPHP (Caddy) config for the launchroom dashboard image.
#
# Classic mode (no worker mode, see docs/README.md D2). The dashboard always
# speaks plain HTTP on :8000: in production, TLS terminates at the edge Caddy
# that the local launchroomd manages, which proxies to this container. HSTS is
# sent by the app (production, https only), see the header block below.
#
# https://frankenphp.dev/docs/config · https://caddyserver.com/docs/caddyfile

{
	skip_install_trust

	servers {
		# The edge Caddy (and the dev host) reach us over a private Docker
		# network; trust X-Forwarded-* only from private ranges.
		trusted_proxies static private_ranges
	}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}

	{$CADDY_GLOBAL_OPTIONS}
}

{$SERVER_NAME::8000} {
	root {$SERVER_ROOT:/var/www/html/public}

	encode zstd br gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# The app (App\Http\Middleware\SecurityHeaders) sets these too, plus
		# the nonce-based Content-Security-Policy and, in production over
		# https, HSTS. This block covers static files that never reach PHP.
		-Server
		-X-Powered-By
	}

	# Long-lived caching for fingerprinted Vite build output.
	@build path /build/assets/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
