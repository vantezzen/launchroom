# Image pins of this release (docs/09 R31). MANAGED: install.sh copies these
# keys into .env on every install and upgrade, replacing the previous values.
#
# Third-party images are pinned by multi-arch index digest. The launchroom
# images are filled in by the release pipeline with @sha256 digests; until
# that pipeline exists they point at tags, and install.sh warns about every
# image without a digest.

# launchroom (ghcr.io/vantezzen, built from deploy/images/dashboard, daemon/
# and deploy/images/caddy). LR_CADDY_IMAGE is the edge Caddy the dashboard
# puts into NodeStates (LAUNCHROOM_CADDY_IMAGE); launchroomd of the same
# release has its digest compiled in and refuses any other (docs/05 §4).
LR_DASHBOARD_IMAGE=ghcr.io/vantezzen/launchroom-dashboard:0.1.0
LR_DAEMON_IMAGE=ghcr.io/vantezzen/launchroomd:0.1.0
LR_CADDY_IMAGE=ghcr.io/vantezzen/launchroom-caddy:0.1.0

# postgres:18-alpine (same digest as config/launchroom.php database_engines)
LR_POSTGRES_IMAGE=docker.io/library/postgres@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
# valkey/valkey:8-alpine
LR_VALKEY_IMAGE=docker.io/valkey/valkey@sha256:081c2f5cb575efc901aa80ff9cdbd1ec6a301682fd35e1ebb4b0990a4a4a8507
# headscale v0.29.5 (the mesh, docs/05 §2)
LR_HEADSCALE_IMAGE=docker.io/headscale/headscale@sha256:780ed2f9e85719a2211277433f2c8afb45105d0d25031949a6848a485f9e216d
# zot v2.1.22
LR_ZOT_IMAGE=ghcr.io/project-zot/zot@sha256:96cda11459ce6f8c60da3b03f03e9f67fd11b3ae2d82c4c04c92b3c608996080
# docker:29.9.1-cli (docker CLI + compose plugin). Not a compose service: the
# helper container launchroomd's self-update and control-plane update run
# `docker compose` / the bundle's installer in (docs/11 §4).
LR_COMPOSE_IMAGE=docker.io/library/docker@sha256:6fae2214c3121a28d5aa639d09032f61310b7c9c75ffbad1025f261a1b621800
