# launchroom control-plane settings. install.sh generates .env from this file
# (mode 0600) and fills in the secrets; you normally never write it by hand.
#
# BACK UP .env TOGETHER WITH data/keys/: APP_KEY and the key files decrypt
# every stored secret, and daemons pin the signing key.

# Public dashboard URL: https://<your domain> or https://<ip-dashed>.sslip.io.
APP_URL=
# false only when APP_URL is plain http (no TLS in front of the dashboard).
SESSION_SECURE_COOKIE=true

# --- Secrets (generated) -----------------------------------------------------
APP_KEY=
# Comma-separated previous APP_KEYs while rotating (docs/09 R13).
APP_PREVIOUS_KEYS=
DB_PASSWORD=
VALKEY_PASSWORD=
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# --- Optional ------------------------------------------------------------------
# Host loopback port of the dashboard (launchroomd's Caddy proxies to it).
LR_DASHBOARD_PORT=8000
LOG_LEVEL=info
LR_LOG_LEVEL=info
# Host time zone for launchroomd (set by install.sh; suggests the server location).
LR_HOST_TIMEZONE=
# Mail (invitations, notifications). Default: written to the log.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=launchroom@localhost
# Docker socket launchroomd manages (rootful Docker).
LR_DOCKER_SOCKET=/var/run/docker.sock

# --- Install state (managed by install.sh) -------------------------------------
# Set only while the local launchroomd enrolls.
LR_JOIN_TOKEN_FILE=
# Set only while `install.sh --move` moves launchroom here (the old dashboard).
LR_CONTROL_PLANE_URL=

# --- Image pins (managed: copied from images.env on install/upgrade) ----------
LR_DASHBOARD_IMAGE=
LR_DAEMON_IMAGE=
LR_CADDY_IMAGE=
LR_POSTGRES_IMAGE=
LR_VALKEY_IMAGE=
LR_ZOT_IMAGE=
