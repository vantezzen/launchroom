          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": [
                    "web-production.shop.apps.example.com",
                    "web-pr-4.shop.apps.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
