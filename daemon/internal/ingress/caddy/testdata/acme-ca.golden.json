              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "launchroom: there is no app at this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ]
        },
        "lr-https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "@id": "lr-route-rt_01J9Z8X7W6V5T4S3R2Q1P0N9R1",
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "encodings": {
                            "gzip": {},
                            "zstd": {}
                          },
                          "handler": "encode",
                          "prefer": [
                            "zstd",
                            "gzip"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "flush_interval": -1,
                          "handler": "reverse_proxy",
                          "health_checks": {
                            "passive": {
                              "fail_duration": "10s",
                              "max_fails": 1,
                              "unhealthy_status": [
                                502,
                                503,
                                504
                              ]
                            }
                          },
                          "load_balancing": {
                            "selection_policy": {
                              "policy": "round_robin"
                            },
                            "try_duration": "5s",
                            "try_interval": "250ms"
                          },
                          "upstreams": [
                            {
                              "dial": "10.231.4.5:3000"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
