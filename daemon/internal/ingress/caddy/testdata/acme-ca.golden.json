    "tls": {
      "automation": {
        "on_demand": {
          "permission": {
            "endpoint": "http://127.0.0.1:2021/caddy/ask",
            "module": "http"
          }
        },
        "policies": [
          {
            "issuers": [
              {
                "ca": "https://pebble:14000/dir",
                "challenges": {
                  "dns": {
                    "provider": {
                      "api_token": "{file./data/launchroom/secrets/dns-token}",
                      "name": "cloudflare"
                    }
                  }
                },
                "module": "acme",
                "trusted_roots_pem_files": [
                  "/data/launchroom/pebble.pem"
                ]
              }
            ],
            "subjects": [
              "*.blog.apps.example.com",
              "*.shop.apps.example.com"
            ]
          },
          {
            "issuers": [
