{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "http_port": 80,
      "https_port": 443,
      "servers": {
        "lr-http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": [
                    "dash.example.com",
                    "1-2-3-4.sslip.io"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": [
                    "dash.localhost"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "launchroom: there is no app at this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ]
        },
        "lr-https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "@id": "lr-route-rt_0000000000000000000000DASH",
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "encodings": {
                            "gzip": {},
                            "zstd": {}
                          },
                          "handler": "encode",
                          "prefer": [
                            "zstd",
                            "gzip"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "flush_interval": -1,
                          "handler": "reverse_proxy",
                          "health_checks": {
                            "passive": {
                              "fail_duration": "10s",
                              "max_fails": 1,
                              "unhealthy_status": [
                                502,
                                503,
                                504
                              ]
                            }
                          },
                          "load_balancing": {
                            "selection_policy": {
                              "policy": "round_robin"
                            },
                            "try_duration": "5s",
                            "try_interval": "250ms"
                          },
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:8000"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "dash.example.com",
                    "1-2-3-4.sslip.io"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "@id": "lr-route-rt_0000000000000000000001DASH",
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "encodings": {
                            "gzip": {},
                            "zstd": {}
                          },
                          "handler": "encode",
                          "prefer": [
                            "zstd",
                            "gzip"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "flush_interval": -1,
                          "handler": "reverse_proxy",
                          "health_checks": {
                            "passive": {
                              "fail_duration": "10s",
                              "max_fails": 1,
                              "unhealthy_status": [
                                502,
                                503,
                                504
                              ]
                            }
                          },
                          "load_balancing": {
                            "selection_policy": {
                              "policy": "round_robin"
                            },
                            "try_duration": "5s",
                            "try_interval": "250ms"
                          },
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:8000"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "dash.localhost"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "launchroom: there is no app at this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "on_demand": {
          "permission": {
            "endpoint": "http://127.0.0.1:2021/caddy/ask",
            "module": "http"
          }
        },
        "policies": [
          {
            "issuers": [
              {
                "module": "internal"
              }
            ],
            "subjects": [
              "dash.localhost"
            ]
          },
          {
            "subjects": [
              "dash.example.com",
              "1-2-3-4.sslip.io"
            ]
          }
        ]
      }
    }
  }
}
