{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "http_port": 80,
      "https_port": 443,
      "servers": {
        "lr-http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": [
                    "pr-3.preview.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "launchroom: there is no app at this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ]
        },
        "lr-https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "@id": "lr-route-rt_01J9Z8X7W6V5T4S3R2Q1P0N9NE",
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "body": "launchroom: this preview's protection is misconfigured, so it is not served.\n",
                          "handler": "static_response",
                          "headers": {
                            "Content-Type": [
                              "text/plain; charset=utf-8"
                            ]
                          },
                          "status_code": 403
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "pr-3.preview.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "launchroom: there is no app at this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "on_demand": {
          "permission": {
            "endpoint": "http://127.0.0.1:2021/caddy/ask",
            "module": "http"
          }
        },
        "policies": [
          {
            "subjects": [
              "pr-3.preview.example.com"
            ]
          }
        ]
      }
    }
  }
}
