{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "http_port": 80,
      "https_port": 443,
      "servers": {
        "lr-http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://shop.example.com{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": [
                    "shop.example.com",
                    "www.shop.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": [
                    "custom.example.org"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": [
                    "web.localhost"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "launchroom: there is no app at this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ]
        },
        "lr-https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "@id": "lr-route-rt_01J9Z8X7W6V5T4S3R2Q1P0N9N9",
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "static_response",
                          "headers": {
                            "Location": [
                              "https://shop.example.com{http.request.uri}"
                            ]
                          },
                          "status_code": 308
                        }
                      ],
                      "match": [
                        {
                          "host": [
                            "www.shop.example.com"
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "headers",
                          "response": {
                            "delete": [
                              "Server"
                            ],
                            "set": {
                              "X-Robots-Tag": [
                                "noindex"
                              ]
                            }
                          }
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "encodings": {
                            "gzip": {},
                            "zstd": {}
                          },
                          "handler": "encode",
                          "prefer": [
                            "zstd",
                            "gzip"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "flush_interval": -1,
                          "handler": "reverse_proxy",
                          "health_checks": {
                            "passive": {
                              "fail_duration": "10s",
                              "max_fails": 1,
                              "unhealthy_status": [
                                502,
                                503,
                                504
                              ]
                            }
                          },
                          "load_balancing": {
                            "selection_policy": {
                              "policy": "round_robin"
                            },
                            "try_duration": "5s",
                            "try_interval": "250ms"
                          },
                          "upstreams": [
                            {
                              "dial": "10.231.4.5:3000"
                            },
                            {
                              "dial": "10.231.4.6:3000"
                            },
                            {
                              "dial": "100.64.0.9:31002"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "shop.example.com",
                    "www.shop.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "@id": "lr-route-rt_01J9Z8X7W6V5T4S3R2Q1P0N9NA",
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "body": "launchroom: this app has no healthy instance right now. Try again in a moment.\n",
                          "handler": "static_response",
                          "headers": {
                            "Content-Type": [
                              "text/plain; charset=utf-8"
                            ]
                          },
                          "status_code": 503
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "custom.example.org"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "@id": "lr-route-rt_01J9Z8X7W6V5T4S3R2Q1P0N9NB",
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "encodings": {
                            "gzip": {},
                            "zstd": {}
                          },
                          "handler": "encode",
                          "prefer": [
                            "zstd",
                            "gzip"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "flush_interval": -1,
                          "handler": "reverse_proxy",
                          "health_checks": {
                            "passive": {
                              "fail_duration": "10s",
                              "max_fails": 1,
                              "unhealthy_status": [
                                502,
                                503,
                                504
                              ]
                            }
                          },
                          "load_balancing": {
                            "selection_policy": {
                              "policy": "round_robin"
                            },
                            "try_duration": "5s",
                            "try_interval": "250ms"
                          },
                          "upstreams": [
                            {
                              "dial": "10.231.4.5:3000"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "web.localhost"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "launchroom: there is no app at this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "on_demand": {
          "permission": {
            "endpoint": "http://127.0.0.1:2021/caddy/ask",
            "module": "http"
          }
        },
        "policies": [
          {
            "issuers": [
              {
                "module": "internal"
              }
            ],
            "subjects": [
              "web.localhost"
            ]
          },
          {
            "on_demand": true,
            "subjects": [
              "custom.example.org"
            ]
          },
          {
            "subjects": [
              "shop.example.com",
              "www.shop.example.com"
            ]
          }
        ]
      }
    }
  }
}
