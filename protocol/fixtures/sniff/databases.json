{
  "description": "Database dump samples and what a sniffer must read from them (docs/14 \u00a712.3). A sample is `text` or `base64` bytes, gzipped first when `gzip` is true. expect: the format (protocol DataFormat), the family that made it (engine id; mariadb imports into mysql), versions, or refused (not importable at all) or generic (SQL without a dump tool's header). compatibility: whether a sample imports into engine at targetVersion. launchroomd (daemon/internal/backup) decides; the dashboard's FileSniffer gives early feedback with the same rules. Both tests read this file.",
  "samples": [
    {
      "name": "pg-custom-15",
      "base64": "UEdETVABDwAECAEAAAwAAAAAHgAAAAAKAAAAABUAAAAACQAAAAB+AAAAAAAAAAAABQAAAHVtYW1pAB4AAAAxNS44IChEZWJpYW4gMTUuOC0xLnBnZGcxMjArMSkAHgAAADE1LjggKERlYmlhbiAxNS44LTEucGdkZzEyMCsxKQ==",
      "expect": {
        "format": "postgres_custom",
        "family": "postgres",
        "serverVersion": "15.8",
        "toolVersion": "15.8",
        "compressed": false
      }
    },
    {
      "name": "pg-custom-15-gzip",
      "base64": "UEdETVABDwAECAEAAAwAAAAAHgAAAAAKAAAAABUAAAAACQAAAAB+AAAAAAAAAAAABQAAAHVtYW1pAAQAAAAxNS44AAQAAAAxNS44",
      "gzip": true,
      "expect": {
        "format": "postgres_custom",
        "family": "postgres",
        "serverVersion": "15.8",
        "toolVersion": "15.8",
        "compressed": true
      }
    },
    {
      "name": "pg-custom-18",
      "base64": "UEdETVABDwAECAEAAAwAAAAAHgAAAAAKAAAAABUAAAAACQAAAAB+AAAAAAAAAAAABQAAAHVtYW1pAAQAAAAxOC4xAAQAAAAxOC4x",
      "expect": {
        "format": "postgres_custom",
        "family": "postgres",
        "serverVersion": "18.1",
        "toolVersion": "18.1",
        "compressed": false
      }
    },
    {
      "name": "pg-custom-tool-18",
      "base64": "UEdETVABDwAECAEAAAwAAAAAHgAAAAAKAAAAABUAAAAACQAAAAB+AAAAAAAAAAAABQAAAHVtYW1pAAQAAAAxNi40AAQAAAAxOC4x",
      "expect": {
        "format": "postgres_custom",
        "family": "postgres",
        "serverVersion": "16.4",
        "toolVersion": "18.1",
        "compressed": false
      }
    },
    {
      "name": "pg-custom-9.6",
      "base64": "UEdETVABDwAECAEAAAwAAAAAHgAAAAAKAAAAABUAAAAACQAAAAB+AAAAAAAAAAAABQAAAHVtYW1pAAYAAAA5LjYuMjQABgAAADkuNi4yNA==",
      "expect": {
        "format": "postgres_custom",
        "family": "postgres",
        "serverVersion": "9.6.24",
        "toolVersion": "9.6.24",
        "compressed": false
      }
    },
    {
      "name": "pg-plain-16",
      "text": "--\n-- PostgreSQL database dump\n--\n\n-- Dumped from database version 16.4\n-- Dumped by pg_dump version 16.4\n\nSET statement_timeout = 0;\n",
      "expect": {
        "format": "postgres_sql",
        "family": "postgres",
        "serverVersion": "16.4",
        "toolVersion": "16.4",
        "compressed": false
      }
    },
    {
      "name": "pg-plain-16-gzip",
      "text": "--\n-- PostgreSQL database dump\n--\n\n-- Dumped from database version 16.4\n-- Dumped by pg_dump version 16.4\n\nSET statement_timeout = 0;\n",
      "gzip": true,
      "expect": {
        "format": "postgres_sql",
        "family": "postgres",
        "serverVersion": "16.4",
        "toolVersion": "16.4",
        "compressed": true
      }
    },
    {
      "name": "pg-cluster",
      "text": "--\n-- PostgreSQL database cluster dump\n--\n",
      "expect": {
        "refused": true
      }
    },
    {
      "name": "mysql-8.0",
      "text": "-- MySQL dump 10.13  Distrib 8.0.36, for Linux (x86_64)\n--\n-- Host: localhost    Database: app\n-- ------------------------------------------------------\n-- Server version\t8.0.36\n",
      "expect": {
        "format": "mysql_sql",
