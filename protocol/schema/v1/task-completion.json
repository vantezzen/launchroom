{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchroom.vantezzen.io/schema/v1/task-completion.json",
  "$defs": {
    "AppliedPreset": {
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Version of the preset code (bumped when its behaviour changes)."
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/PresetDecision"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "version",
        "decisions"
      ],
      "description": "AppliedPreset is a launchroom preset that matched and the decisions it applied."
    },
    "BackupResult": {
      "properties": {
        "snapshotId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8,64}$",
          "description": "SnapshotID is the full restic snapshot id."
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "SizeBytes is the size of the streamed dump (bytes read by restic)."
        },
        "addedBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "AddedBytes is what the snapshot added to the repository after deduplication (if restic reported it)."
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "snapshotId",
        "sizeBytes",
        "durationMs"
      ],
      "description": "BackupResult is the outcome of a successful backup task."
    },
    "BackupSnapshotsResult": {
      "properties": {
        "snapshots": {
          "items": {
            "$ref": "#/$defs/SnapshotInfo"
          },
          "type": "array",
          "maxItems": 1000
        },
        "truncated": {
          "type": "boolean",
          "description": "Truncated is true when more than MaxSnapshotsListed snapshots matched."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "snapshots"
      ],
      "description": "BackupSnapshotsResult lists snapshots, newest first."
    },
    "BuildResult": {
      "properties": {
        "image": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?:localhost|[a-z0-9-]+(?:\\.[a-z0-9-]+)+|[a-z0-9-]+(?:\\.[a-z0-9-]+)*:[0-9]{1,5})(?:/[a-z0-9]+(?:(?:\\.|_|__|-+)[a-z0-9]+)*)+@sha256:[a-f0-9]{64}$",
          "description": "Image is the pushed image, digest-pinned in the spec's repository\n(\"127.0.0.1:5000/apps/\u003cservice\u003e@sha256:…\"). The digest is that of the\nimage index, which also carries the SBOM and provenance attestations."
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "oneOf": [
            {
              "$ref": "#/$defs/BuildSummary",
              "description": "Summary is what was detected and applied (\"we detected…\", docs/04 §4)."
            },
            {
              "type": "null"
            }
          ]
        },
        "secretsHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SecretsHash is SHA-256 over the sorted NAME=value pairs of the build-scoped\nvariables (part of the build key, docs/04 §7). Omitted without build variables."
        },
        "attestations": {
          "oneOf": [
            {
              "items": {
                "type": "string",
                "enum": [
                  "sbom",
                  "provenance"
                ]
              },
              "type": "array",
              "description": "Attestations attached to the image index."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "image",
        "durationMs"
      ],
      "description": "BuildResult is the outcome of a build."
    },
    "BuildSummary": {
      "properties": {
        "builder": {
          "type": "string",
          "enum": [
            "auto",
            "dockerfile",
            "railpack"
          ]
        },
        "builderReason": {
          "type": "string",
          "enum": [
            "explicit",
            "dockerfile_detected",
            "preset",
            "railpack"
          ]
        },
        "dockerfilePath": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9._@+=,-]+(?:/[A-Za-z0-9._@+=,-]+)*$",
          "description": "DockerfilePath is the Dockerfile used (dockerfile builds), relative to rootDir."
        },
        "railpackVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "description": "RailpackVersion is the Railpack version that planned the build (railpack builds)."
        },
        "provider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "description": "Provider is the Railpack provider (\"node\", \"php\", \"python\", …)."
        },
        "framework": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "description": "Framework is the detected framework (\"next\", \"vite\", \"laravel\", \"django\", \"fastapi\", \"express\", …)."
        },
        "packageManager": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "description": "PackageManager is the detected package manager (\"npm\", \"pnpm\", \"composer\", \"uv\", …)."
        },
        "packages": {
          "oneOf": [
            {
              "items": {
                "$ref": "#/$defs/ResolvedPackage"
              },
              "type": "array",
              "maxItems": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "installCommand": {
          "type": "string",
          "maxLength": 4096,
          "description": "Commands as they run inside the build/app container (shell strings, display only)."
        },
        "buildCommand": {
          "type": "string",
          "maxLength": 4096
        },
        "startCommand": {
          "type": "string",
          "maxLength": 4096
        },
        "port": {
          "oneOf": [
            {
              "type": "integer",
              "maximum": 65535,
              "minimum": 1,
              "description": "Port is the port the app is expected to listen on ($PORT is injected with this value)."
            },
            {
              "type": "null"
            }
          ]
        },
        "presets": {
          "oneOf": [
            {
              "items": {
                "$ref": "#/$defs/AppliedPreset"
              },
              "type": "array",
              "maxItems": 8
            },
            {
              "type": "null"
            }
          ]
        },
        "runtimeEnv": {
          "oneOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object",
              "description": "RuntimeEnv are non-secret runtime defaults suggested by presets (HOSTNAME=0.0.0.0, …)."
            },
            {
              "type": "null"
            }
          ]
        },
        "processes": {
          "oneOf": [
            {
              "items": {
                "$ref": "#/$defs/ProcessSuggestion"
              },
              "type": "array",
              "maxItems": 16,
              "description": "Processes are suggested extra processes from the same image."
            },
            {
              "type": "null"
            }
          ]
        },
        "releaseCommand": {
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array",
              "maxItems": 64,
              "minItems": 1,
              "description": "ReleaseCommand runs once per deploy before rollout (argv), e.g. migrations."
            },
            {
              "type": "null"
            }
          ]
        },
        "healthPath": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^/[A-Za-z0-9._~!$\u0026'()*+,;=:@%/?-]*$",
          "description": "HealthPath is the suggested HTTP health check path."
        },
        "buildEnv": {
          "oneOf": [
            {
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,255}$"
              },
              "type": "array",
              "maxItems": 1024,
              "description": "BuildEnv names the build-scoped variables passed as BuildKit secrets (names only)."
            },
            {
              "type": "null"
            }
          ]
        },
        "envReferences": {
          "oneOf": [
            {
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,255}$"
              },
              "type": "array",
              "maxItems": 256,
              "description": "EnvReferences are variable names referenced in the source (cheap static scan)."
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "oneOf": [
            {
              "items": {
                "$ref": "#/$defs/BuildWarning"
              },
              "type": "array",
              "maxItems": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "plan": {
          "type": "object",
          "description": "Plan is the resolved Railpack build plan (railpack builds); it lists secret names only."
        },
        "next": {
          "oneOf": [
            {
              "$ref": "#/$defs/NextBuildInfo",
              "description": "Next is what the launchroom Next.js deployment adapter reported (build tasks of Next ≥ 16.2 apps)."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "builder",
        "builderReason"
      ],
      "description": "BuildSummary is the \"we detected…\" data (docs/04 §4): the resolved builder, what Railpack detected, the preset decisions and the runtime contract."
    },
    "BuildWarning": {
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "description": "BuildWarning is a non-fatal finding shown with the plan."
    },
    "DataExportResult": {
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "postgres_custom",
            "postgres_sql",
            "mysql_sql",
            "mongodb_archive",
            "clickhouse_backup",
            "redis_rdb",
            "tar",
            "zip"
          ]
        },
        "compressed": {
          "type": "boolean",
          "description": "Compressed: the file is gzip-compressed as a whole (.sql.gz, .tar.gz)."
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "chunks": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "format",
        "sizeBytes",
        "chunks",
        "sha256",
        "durationMs"
      ],
      "description": "DataExportResult is the outcome of a db_export or volume_export task: the uploaded file (Chunks chunks of the target's chunkBytes, the last one shorter) and its digest in TransferRef's scheme."
    },
    "DataImportResult": {
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "inspect",
            "import"
          ]
        },
        "empty": {
          "type": "boolean",
          "description": "Empty: no tables/collections (databases) or no files (volumes)."
        },
        "tables": {
          "type": "integer",
          "minimum": 0,
          "description": "Tables are tables (Postgres, MySQL) or collections (MongoDB)."
        },
        "files": {
          "type": "integer",
          "minimum": 0,
          "description": "Files are the entries extracted (volume imports)."
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "SizeBytes is the database's size, or the bytes extracted into a volume."
        },
        "serverVersion": {
          "type": "string",
          "maxLength": 64,
          "description": "ServerVersion is the target engine's version (\"17.6\")."
        },
        "rootOwner": {
          "oneOf": [
            {
              "$ref": "#/$defs/FileOwner",
              "description": "RootOwner is the owner of the volume's root folder (volumes)."
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "postgres_custom",
            "postgres_sql",
            "mysql_sql",
            "mongodb_archive",
            "clickhouse_backup",
            "redis_rdb",
            "tar",
            "zip"
          ],
          "description": "Format and Compressed describe the source file as launchroomd read it."
        },
        "compressed": {
          "type": "boolean"
        },
        "sourceVersion": {
          "type": "string",
          "maxLength": 64,
          "description": "SourceVersion is what made the source (\"PostgreSQL 16.4\", \"MySQL\n8.0.36\", \"MariaDB 10.11.6\", \"MongoDB 7.0.5\"), when it says."
        },
        "readBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "ReadBytes is how much was read from the source (file or stream)."
        },
        "warnings": {
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array",
              "maxItems": 8,
              "description": "Warnings are short notes about what launchroomd adjusted (\"Removed\nDEFINER clauses from 3 views and routines\")."
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "mode",
        "empty",
        "durationMs"
      ],
      "description": "DataImportResult is the outcome of a db_import or volume_import task (both modes)."
    },
    "FailureHint": {
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "description": "FailureHint is a known-error hint (\"ERR_PNPM_OUTDATED_LOCKFILE → run pnpm install and commit the lockfile\")."
    },
    "FileOwner": {
      "properties": {
        "uid": {
          "type": "integer",
          "maximum": 2147483647,
          "minimum": 0
        },
        "gid": {
          "type": "integer",
          "maximum": 2147483647,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "uid",
        "gid"
      ],
      "description": "FileOwner is a numeric owner for imported files."
    },
    "InspectedFile": {
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9._@+=,-]+(?:/[A-Za-z0-9._@+=,-]+)*$"
        },
        "content": {
          "type": "string",
          "maxLength": 32768
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path",
        "content",
        "truncated"
      ],
      "description": "InspectedFile is one file of a RepoInspection (UTF-8 text, cut at its limit)."
    },
    "MaintenanceResult": {
      "properties": {
        "removedSnapshots": {
          "type": "integer",
          "minimum": 0,
          "description": "RemovedSnapshots is the number of snapshots forget removed (forget only)."
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "durationMs"
      ],
      "description": "MaintenanceResult is the outcome of a successful backup_maintenance task."
    },
    "NextBuildInfo": {
      "properties": {
        "adapterVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "nextVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "deploymentId": {
          "type": "string",
          "maxLength": 128,
          "description": "DeploymentID is the Next.js deploymentId baked into the build (skew protection)."
        },
        "serverEntry": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9._@+=,-]+(?:/[A-Za-z0-9._@+=,-]+)*$",
          "description": "ServerEntry is the standalone server, relative to the app directory (\".next/standalone/server.js\")."
        },
        "middleware": {
          "type": "boolean",
          "description": "Middleware says whether the app has middleware/proxy, and its runtime (\"nodejs\", \"edge\")."
        },
        "middlewareRuntime": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "imageOptimization": {
          "type": "boolean",
          "description": "ImageOptimization is on unless images.unoptimized or a custom loader is configured; Sharp says whether sharp is installed."
        },
        "sharp": {
          "type": "boolean"
        },
        "cacheHandler": {
          "type": "boolean",
          "description": "CacheHandler says whether a cacheHandler/cacheHandlers is configured (shared ISR cache)."
        },
        "routes": {
          "$ref": "#/$defs/NextRouteCounts"
        },
        "isrRoutes": {
          "oneOf": [
            {
              "items": {
                "type": "string",
                "maxLength": 1024,
                "pattern": "^/[A-Za-z0-9._~!$\u0026'()*+,;=:@%/?-]*$"
              },
              "type": "array",
              "maxItems": 32,
              "description": "ISRRoutes are prerendered paths with time-based revalidation (first 32)."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "adapterVersion",
        "nextVersion",
        "middleware",
        "imageOptimization",
        "sharp",
        "cacheHandler",
        "routes"
      ],
      "description": "NextBuildInfo is the build manifest summary of @vantezzen/launchroom-next-adapter (docs/04 §3): what the dashboard shows about a Next.js build."
    },
    "NextRouteCounts": {
      "properties": {
        "appPages": {
          "type": "integer",
          "maximum": 1000000,
          "minimum": 0
        },
        "appRoutes": {
          "type": "integer",
          "maximum": 1000000,
          "minimum": 0
        },
        "pages": {
          "type": "integer",
          "maximum": 1000000,
          "minimum": 0
        },
        "pagesApi": {
          "type": "integer",
          "maximum": 1000000,
          "minimum": 0
        },
        "staticFiles": {
          "type": "integer",
          "maximum": 1000000,
          "minimum": 0
        },
        "prerendered": {
          "type": "integer",
          "maximum": 1000000,
          "minimum": 0,
          "description": "Prerendered counts fully static prerenders, ISR those with time-based revalidation."
        },
        "isr": {
          "type": "integer",
          "maximum": 1000000,
          "minimum": 0
        },
        "edge": {
          "type": "integer",
          "maximum": 1000000,
          "minimum": 0,
          "description": "Edge counts routes built for the edge runtime (they run in the Node.js server here)."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "appPages",
        "appRoutes",
        "pages",
        "pagesApi",
        "staticFiles",
        "prerendered",
        "isr",
        "edge"
      ],
      "description": "NextRouteCounts counts the user-facing outputs of a Next.js build."
    },
    "PlanResult": {
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "$ref": "#/$defs/BuildSummary"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "durationMs",
        "summary"
      ],
      "description": "PlanResult is the outcome of a plan task."
    },
    "PresetDecision": {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "description": "ID is stable per preset version; BuilderSpec.disabledDecisions references it."
        },
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "detail": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "description": "PresetDecision is one removable decision a preset made (a UI chip)."
    },
    "ProbeOutcome": {
      "properties": {
        "listening": {
          "type": "boolean",
          "description": "Listening: the container accepted TCP connections on the port (and the\nHTTP path answered below 500, when one was given)."
        },
        "afterMs": {
          "type": "integer",
          "minimum": 0
        },
        "httpStatus": {
          "type": "integer",
          "maximum": 599,
          "minimum": 100,
          "description": "HTTPStatus is the status of the HTTP check, if one ran."
        },
        "exited": {
          "type": "boolean",
          "description": "Exited: the container stopped before the check passed."
        },
        "listeningPorts": {
          "oneOf": [
            {
              "items": {
                "type": "integer",
                "maximum": 65535,
                "minimum": 1
              },
              "type": "array",
              "maxItems": 16,
              "description": "ListeningPorts are the TCP ports the process did open (when not listening)."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "listening",
        "afterMs",
        "exited"
      ],
      "description": "ProbeOutcome is what a run_once start check found."
    },
    "ProcessSuggestion": {
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "maxItems": 64,
          "minItems": 1,
          "description": "Args is the argv to run in the image (never a shell string)."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "args"
      ],
      "description": "ProcessSuggestion is an extra process from the same image (queue worker, scheduler, …)."
    },
    "RepoInspection": {
      "properties": {
        "tree": {
          "oneOf": [
            {
              "items": {
                "type": "string",
                "maxLength": 1024,
                "pattern": "^[A-Za-z0-9._@+=,-]+(?:/[A-Za-z0-9._@+=,-]+)*$"
              },
              "type": "array",
              "maxItems": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "treeTruncated": {
          "type": "boolean"
        },
        "files": {
          "oneOf": [
            {
              "items": {
                "$ref": "#/$defs/InspectedFile"
              },
              "type": "array",
              "maxItems": 48
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "tree",
        "treeTruncated",
        "files"
      ],
      "description": "RepoInspection is what launchroomd read from a checkout for a generated Dockerfile (plan tasks with inspect): a file listing of the app directory and selected manifest and entry files, never secrets (docs/20 §2)."
    },
    "ResolvedPackage": {
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "version": {
          "type": "string",
          "maxLength": 128
        },
        "source": {
          "type": "string",
          "maxLength": 256,
          "description": "Source says where the version came from (\".nvmrc\", \"package.json \u003e engines\", \"railpack default\", …)."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "description": "ResolvedPackage is a toolchain/package version Railpack resolved and where it came from."
    },
    "RestoreResult": {
      "properties": {
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "SizeBytes is the size of the dump fed into the engine's restore tool."
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "restoredTo": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "description": "RestoredTo is the time of the last transaction replayed (base_backup restores)."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "sizeBytes",
        "durationMs"
      ],
      "description": "RestoreResult is the outcome of a successful restore task."
    },
    "RunOnceResult": {
      "properties": {
        "exitCode": {
          "type": "integer",
          "description": "ExitCode is the container's exit code, or 0 when launchroomd stopped\nit after a passing probe."
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "probe": {
          "oneOf": [
            {
              "$ref": "#/$defs/ProbeOutcome",
              "description": "Probe is the outcome of the spec's start check (docs/20 §5)."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "exitCode",
        "durationMs"
      ],
      "description": "RunOnceResult is the outcome of a one-off container."
    },
    "SelfUpdateResult": {
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "daemon",
            "control_plane"
          ]
        },
        "fromVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "toVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "rolledBack": {
          "type": "boolean",
          "description": "RolledBack is true when the new version was installed but did not\nbecome healthy and the previous version was restored."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "scope",
        "fromVersion",
        "toVersion",
        "rolledBack"
      ],
      "description": "SelfUpdateResult describes a finished self_update (docs/11 §4)."
    },
    "SessionCommandResult": {
      "properties": {
        "op": {
          "type": "string",
          "pattern": "^op_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "error",
            "refused"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "op",
        "status",
        "rows",
        "durationMs"
      ],
      "description": "SessionCommandResult is the outcome of one data command (TaskCompletion.session.commands)."
    },
    "SessionResult": {
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "description": "StartedAt is when the shell started or the first command ran."
        },
        "endReason": {
          "type": "string",
          "enum": [
            "closed",
            "exited",
            "idle",
            "deadline",
            "disconnected",
            "ended",
            "never_connected",
            "refused",
            "error"
          ]
        },
        "exitCode": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "bytesIn": {
          "type": "integer",
          "minimum": 0
        },
        "bytesOut": {
          "type": "integer",
          "minimum": 0
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/SessionCommandResult"
          },
          "type": "array",
          "maxItems": 1000
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "endReason",
        "bytesIn",
        "bytesOut"
      ],
      "description": "SessionResult is reported for finished session tasks."
    },
    "SnapshotInfo": {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8,64}$"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}:[A-Za-z0-9_.-]{1,128}$"
          },
          "type": "array",
          "maxItems": 32,
          "description": "Tags are the snapshot's tags that match the BackupTag grammar (others are dropped)."
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "SizeBytes is the size of the backed-up data, if restic recorded it."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "time",
        "tags"
      ],
      "description": "SnapshotInfo is one restic snapshot as listed by backup_snapshots."
    },
    "TaskFailure": {
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "plan_error",
            "build_error",
            "transient",
            "clone_error",
            "config_error",
            "timeout",
            "internal_error"
          ]
        },
        "step": {
          "type": "string",
          "maxLength": 128,
          "description": "Step is the build step that failed (\"clone\", \"plan\", \"install\", \"build\", \"push\", …)."
        },
        "retryable": {
          "type": "boolean",
          "description": "Retryable says whether retrying the same inputs may succeed."
        },
        "hints": {
          "oneOf": [
            {
              "items": {
                "$ref": "#/$defs/FailureHint"
              },
              "type": "array",
              "maxItems": 16
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "oneOf": [
            {
              "$ref": "#/$defs/BuildSummary",
              "description": "Summary is set when planning got far enough to detect something (plan_error, build_error)."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "class",
        "retryable"
      ],
      "description": "TaskFailure classifies a failed build or plan task."
    },
    "VerifyCheck": {
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "restore",
            "replay",
            "start",
            "query",
            "amcheck",
            "mysqlcheck",
            "rdb",
            "archive",
            "validate",
            "checktable"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "maxLength": 512,
          "description": "Detail is a short, secret-free result (\"12 tables, 3,401 rows\", an error excerpt)."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "passed"
      ],
      "description": "VerifyCheck is one check of a verification."
    },
    "VerifyResult": {
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/VerifyCheck"
          },
          "type": "array",
          "maxItems": 16
        },
        "tables": {
          "type": "integer",
          "minimum": 0,
          "description": "Tables and Rows were counted in the restored database (databases)."
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0,
          "description": "Files and Bytes were read from the volume snapshot (volumes), or the\nsize of the restored dump/RDB (databases)."
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "restoredTo": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "description": "RestoredTo is the time of the last transaction replayed (base_backup)."
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "passed",
        "checks",
        "durationMs"
      ],
      "description": "VerifyResult is the outcome of a verify_restore task that got as far as restoring: Passed is false when any check failed (the task still succeeds; the dashboard records the failed verification)."
    }
  },
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "launchroom.vantezzen.io/v1"
    },
    "kind": {
      "type": "string",
      "const": "TaskCompletion"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "released"
      ]
    },
    "error": {
      "type": "string",
      "maxLength": 4096,
      "description": "Error is a short, secret-free failure description."
    },
    "build": {
      "oneOf": [
        {
          "$ref": "#/$defs/BuildResult",
          "description": "Build is set for successful build tasks."
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "oneOf": [
        {
          "$ref": "#/$defs/PlanResult",
          "description": "Plan is set for successful plan tasks."
        },
        {
          "type": "null"
        }
      ]
    },
    "failure": {
      "oneOf": [
        {
          "$ref": "#/$defs/TaskFailure",
          "description": "Failure classifies a failed build or plan task (docs/04 §6)."
        },
        {
          "type": "null"
        }
      ]
    },
    "runOnce": {
      "oneOf": [
        {
          "$ref": "#/$defs/RunOnceResult",
          "description": "RunOnce is set for run_once tasks that ran."
        },
        {
          "type": "null"
        }
      ]
    },
    "backup": {
      "oneOf": [
        {
          "$ref": "#/$defs/BackupResult",
          "description": "Backup is set for successful backup tasks."
        },
        {
          "type": "null"
        }
      ]
    },
    "restore": {
      "oneOf": [
        {
          "$ref": "#/$defs/RestoreResult",
          "description": "Restore is set for successful restore tasks."
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshots": {
      "oneOf": [
        {
          "$ref": "#/$defs/BackupSnapshotsResult",
          "description": "Snapshots is set for successful backup_snapshots tasks."
        },
        {
          "type": "null"
        }
      ]
    },
    "maintenance": {
      "oneOf": [
        {
          "$ref": "#/$defs/MaintenanceResult",
          "description": "Maintenance is set for successful backup_maintenance tasks."
        },
        {
          "type": "null"
        }
      ]
    },
    "selfUpdate": {
      "oneOf": [
        {
          "$ref": "#/$defs/SelfUpdateResult",
          "description": "SelfUpdate is set for self_update tasks, succeeded or failed."
        },
        {
          "type": "null"
        }
      ]
    },
    "verify": {
      "oneOf": [
        {
          "$ref": "#/$defs/VerifyResult",
          "description": "Verify is the result of a verify_restore task."
        },
        {
          "type": "null"
        }
      ]
    },
    "session": {
      "oneOf": [
        {
          "$ref": "#/$defs/SessionResult",
          "description": "Session is set for finished session tasks (docs/03 §11)."
        },
        {
          "type": "null"
        }
      ]
    },
    "inspection": {
      "oneOf": [
        {
          "$ref": "#/$defs/RepoInspection",
          "description": "Inspection is set for plan tasks with inspect, succeeded or failed,\nonce the checkout exists (docs/20 §2)."
        },
        {
          "type": "null"
        }
      ]
    },
    "dataImport": {
      "oneOf": [
        {
          "$ref": "#/$defs/DataImportResult",
          "description": "DataImport is set for db_import and volume_import tasks that succeeded (D55)."
        },
        {
          "type": "null"
        }
      ]
    },
    "dataExport": {
      "oneOf": [
        {
          "$ref": "#/$defs/DataExportResult",
          "description": "DataExport is set for db_export and volume_export tasks that succeeded (D55)."
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "attempt",
    "outcome"
  ],
  "title": "TaskCompletion: POST /daemon/v1/tasks/{id}/complete body",
  "description": "TaskCompletion reports the outcome of one attempt."
}
