{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchroom.vantezzen.io/schema/v1/enroll-response.json",
  "$defs": {
    "MeshEnrollment": {
      "properties": {
        "loginServer": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://[a-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~!$\u0026'()*+,;=:@%/-]*)?$"
        },
        "preAuthKey": {
          "$ref": "#/$defs/Sealed",
          "description": "PreAuthKey is sealed to the daemon's X25519 key."
        },
        "tags": {
          "items": {
            "type": "string",
            "pattern": "^tag:[a-z0-9-]{1,63}$"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "loginServer",
        "preAuthKey",
        "tags"
      ],
      "description": "MeshEnrollment carries the Headscale pre-auth key."
    },
    "NudgeConfig": {
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "description": "Key is the public Pusher application key."
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^wss?://[a-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~-]+)*$",
          "description": "URL is the WebSocket base URL. Omitted: derived from the daemon's\ncontrol-plane URL (http→ws, https→wss, same host and path), where the\ndashboard proxies /app/* to Reverb."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "key"
      ],
      "description": "NudgeConfig tells the daemon where to receive nudges."
    },
    "PollIntervals": {
      "properties": {
        "state": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,5}(?:ms|s|m|h)$"
        },
        "tasks": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,5}(?:ms|s|m|h)$"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "state",
        "tasks"
      ],
      "description": "PollIntervals are the fallback polling intervals (jittered by the daemon)."
    },
    "RegistryInfo": {
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^(?:[0-9]{1,3}(?:\\.[0-9]{1,3}){3}|\\[[0-9a-f:.]{2,45}\\]):[0-9]{1,5}$",
          "description": "Address the Docker daemon pulls from; always the local forwarder or Zot (\"127.0.0.1:5000\")."
        },
        "forwardTo": {
          "type": "string",
          "pattern": "^(?:[0-9]{1,3}(?:\\.[0-9]{1,3}){3}|\\[[0-9a-f:.]{2,45}\\]):[0-9]{1,5}$",
          "description": "ForwardTo is Zot's mesh address on servers other than the control-plane host."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "address"
      ],
      "description": "RegistryInfo tells the daemon where to pull images from."
    },
    "Sealed": {
      "properties": {
        "sealed": {
          "type": "string",
          "maxLength": 1048576,
          "minLength": 64,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "sealed"
      ],
      "description": "Sealed wraps a sealed payload: {\"sealed\": \"\u003cbase64\u003e\"}."
    }
  },
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "launchroom.vantezzen.io/v1"
    },
    "kind": {
      "type": "string",
      "const": "EnrollResponse"
    },
    "serverId": {
      "type": "string",
      "pattern": "^srv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending_approval"
      ]
    },
    "controlPlaneKeys": {
      "additionalProperties": {
        "type": "string",
        "pattern": "^ed25519:[A-Za-z0-9+/]{43}=$"
      },
      "type": "object",
      "description": "ControlPlaneKeys is the trusted key set (kid → \"ed25519:\u003cbase64\u003e\"). It must\ncontain the pinned key under the kid that signed this response."
    },
    "registry": {
      "$ref": "#/$defs/RegistryInfo"
    },
    "mesh": {
      "oneOf": [
        {
          "$ref": "#/$defs/MeshEnrollment",
          "description": "Mesh is set when the mesh is enabled (docs/05 §2)."
        },
        {
          "type": "null"
        }
      ]
    },
    "pollIntervals": {
      "$ref": "#/$defs/PollIntervals"
    },
    "nudge": {
      "oneOf": [
        {
          "$ref": "#/$defs/NudgeConfig",
          "description": "Nudge is where realtime nudges come from (docs/03 §4); omitted when off.\nGET /daemon/v1/config returns the current value later."
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "serverId",
    "status",
    "controlPlaneKeys",
    "registry",
    "pollIntervals"
  ],
  "title": "EnrollResponse: signed response to an enrollment",
  "description": "EnrollResponse is the signed answer to an enrollment."
}
