{
  "grammars": {
    "backupTag": "^[a-z][a-z0-9_-]{0,31}:[A-Za-z0-9_.-]{1,128}$",
    "base64": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
    "bucket": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
    "containerPath": "^/[A-Za-z0-9._@+=,-]+(?:/[A-Za-z0-9._@+=,-]+)*$",
    "cron": "^[0-9*,/-]+( [0-9*,/-]+){4}$",
    "daemonFeature": "^[a-z][A-Za-z0-9]{0,31}$",
    "databaseIdent": "^[A-Za-z0-9_]{1,63}$",
    "ed25519Key": "^ed25519:[A-Za-z0-9+/]{43}=$",
    "envName": "^[A-Za-z_][A-Za-z0-9_]{0,255}$",
    "factText": "^[^\\x00-\\x1f\\x7f]{1,128}$",
    "forwardAuthUrl": "^https?://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::[1-9][0-9]{0,4})?/auth/preview$",
    "gitSha": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
    "hex64": "^[a-f0-9]{64}$",
    "hostName": "^lr-[a-z0-9][a-z0-9_-]{0,59}$",
    "hostname": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
    "httpPath": "^/[A-Za-z0-9._~!$\u0026'()*+,;=:@%/?-]*$",
    "imageRef": "^(?:localhost|[a-z0-9-]+(?:\\.[a-z0-9-]+)+|[a-z0-9-]+(?:\\.[a-z0-9-]+)*:[0-9]{1,5})(?:/[a-z0-9]+(?:(?:\\.|_|__|-+)[a-z0-9]+)*)+@sha256:[a-f0-9]{64}$",
    "joinToken": "^[A-Za-z0-9_.-]{16,256}$",
    "label": "^[A-Za-z0-9._-]{1,128}$",
    "objectPrefix": "^(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]*$",
    "publicId": "^[a-z]{2,4}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
    "region": "^[a-z0-9-]{1,32}$",
    "relPath": "^[A-Za-z0-9._@+=,-]+(?:/[A-Za-z0-9._@+=,-]+)*$",
    "s3Endpoint": "^https?://[a-z0-9.-]+(?::[0-9]{1,5})?$",
    "semver": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
    "slug": "^[a-z0-9][a-z0-9-]{0,62}$",
    "snapshotId": "^[a-f0-9]{8,64}$",
    "socketId": "^[0-9]{1,20}\\.[0-9]{1,20}$",
    "sshFingerprint": "^SHA256:[A-Za-z0-9+/]{43}$",
    "timezone": "^[A-Za-z][A-Za-z0-9_+-]{0,31}(/[A-Za-z0-9_+-]{1,32}){0,2}$",
    "ulid": "[0-7][0-9A-HJKMNP-TV-Z]{25}",
    "wafLabel": "^[A-Za-z0-9][A-Za-z0-9 ._/+-]{0,63}$",
    "wafPathPrefix": "^/[A-Za-z0-9._~/-]{0,127}$",
    "walSegment": "^[0-9A-F]{24}$",
    "x25519Key": "^x25519:[A-Za-z0-9+/]{43}=$"
  },
  "forbiddenMountTargets": [
    "/proc",
    "/sys",
    "/dev",
    "/var/run/docker.sock",
    "/run/docker.sock"
  ],
  "limits": {
    "argLength": 8192,
    "argv": 256,
    "certStorageMeshPort": 6379,
    "envValueBytes": 131072,
    "envVars": 1024,
    "healthDurationSeconds": 3600,
    "linkProbeMeshPort": 7400,
    "linkProbePeers": 256,
    "listItems": 1024,
    "logLineBytes": 16384,
    "meshAllowFrom": 256,
    "meshPortMax": 32999,
    "meshPortMin": 31000,
    "messageBytes": 4096,
    "registryMeshPort": 5000,
    "routeUpstreams": 64,
    "wafExcludableMax": 944999,
    "wafExcludableMin": 911000,
    "wafExclusions": 50,
    "wafRuleMax": 999999,
    "wafRuleMin": 900000
  },
  "intSets": {
    "wafInspectBodyKib": [
      32,
      128,
      1024
    ]
  },
  "constants": {
    "apiVersion": "launchroom.vantezzen.io/v1",
    "meshRange": "100.64.0.0/10",
    "networkPrefix": "lr-e_",
    "registryAddress": "127.0.0.1:5000",
    "volumePrefix": "lr-v_"
  },
  "features": [
    "clientCertificates",
    "configFiles",
    "consoleSessions",
    "containerInspection",
    "controlPlaneUrl",
    "cronSchedule",
    "dataSessions",
    "dataTransfer",
    "dnsProviders",
    "generatedDockerfile",
    "gitProviders",
    "inventory",
    "linkProbe",
    "mongoClickhouse",
    "phpExtensions",
    "pointInTime",
    "preparedVolumes",
    "remoteAccessDatabase",
    "remoteAccessSsh",
    "remoteAccessVolume",
    "requestAnalytics",
    "serviceStop",
    "sharedVolumes",
    "shipLogs",
    "stopSpec",
    "verifyRestore",
    "waf"
  ],
  "fieldFeatures": {
    "NodeState.routes[].clientAuth": "clientCertificates",
    "NodeState.routes[].stopped": "serviceStop",
    "NodeState.routes[].waf": "waf",
    "NodeState.system.controlPlane": "controlPlaneUrl",
    "NodeState.system.linkProbe": "linkProbe",
    "NodeState.volumes[].service": "sharedVolumes",
    "NodeState.workloads[].files": "configFiles",
    "NodeState.workloads[].schedule": "cronSchedule",
    "NodeState.workloads[].shipLogs": "shipLogs",
    "NodeState.workloads[].stop": "stopSpec",
    "NodeState.workloads[].walArchive": "pointInTime",
    "Task(build).spec.builder.dockerfile": "generatedDockerfile",
    "Task(build).spec.builder.phpExtensions": "phpExtensions",
    "Task(build).spec.repo.knownHosts": "gitProviders",
    "Task(build).spec.repo.ref": "gitProviders",
    "Task(build).spec.sshKey": "gitProviders",
    "Task(inventory).spec.source.repo.knownHosts": "gitProviders",
    "Task(inventory).spec.source.repo.ref": "gitProviders",
    "Task(plan).spec.builder.dockerfile": "generatedDockerfile",
    "Task(plan).spec.builder.phpExtensions": "phpExtensions",
    "Task(plan).spec.inspect": "generatedDockerfile",
    "Task(plan).spec.repo.knownHosts": "gitProviders",
    "Task(plan).spec.repo.ref": "gitProviders",
    "Task(plan).spec.sshKey": "gitProviders",
    "Task(run_once).spec.probe": "generatedDockerfile"
  },
  "taskFeatures": {
    "access:database": "remoteAccessDatabase",
    "access:ssh": "remoteAccessSsh",
    "access:volume": "remoteAccessVolume",
    "db_export": "dataTransfer",
    "db_import": "dataTransfer",
    "inspect_container": "containerInspection",
    "inventory": "inventory",
    "session:console": "consoleSessions",
    "session:data": "dataSessions",
    "verify_restore": "verifyRestore",
    "volume_export": "dataTransfer",
    "volume_import": "dataTransfer"
  },
  "valueFeatures": {
    "BackupKind": {
      "base_backup": "pointInTime"
    },
    "DNSProvider": {
      "desec": "dnsProviders",
      "digitalocean": "dnsProviders",
      "gandi": "dnsProviders",
      "netcup": "dnsProviders",
      "ovh": "dnsProviders",
      "porkbun": "dnsProviders",
      "route53": "dnsProviders"
    },
    "DatabaseEngine": {
      "clickhouse": "mongoClickhouse",
      "mongodb": "mongoClickhouse"
    },
    "GitProvider": {
      "gitea": "gitProviders",
      "gitlab": "gitProviders"
    }
  },
  "hintCodes": [
    "buildkit-crash-loop",
    "buildkit-not-ready",
    "buildkit-oom",
    "buildkit-userns-restricted",
    "django-improperly-configured",
    "missing-module",
    "no-start-command",
    "node-gyp-toolchain",
    "npm-ci-lockfile",
    "out-of-memory",
    "php-extension",
    "pnpm-outdated-lockfile",
    "python-module-not-found",
    "railpack-cannot-plan",
    "registry-rate-limit",
    "vite-env-undefined",
    "yarn-frozen-lockfile"
  ]
}
