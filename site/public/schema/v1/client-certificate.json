{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchroom.vantezzen.io/schema/v1/client-certificate.json",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "launchroom.vantezzen.io/v1"
    },
    "kind": {
      "type": "string",
      "const": "ClientCertificate"
    },
    "serverId": {
      "type": "string",
      "pattern": "^srv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "certificate": {
      "type": "string",
      "maxLength": 8192,
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "caCertificates": {
      "items": {
        "type": "string",
        "maxLength": 8192,
        "minLength": 4,
        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
      },
      "type": "array",
      "maxItems": 4,
      "minItems": 1
    },
    "notBefore": {
      "type": "string",
      "format": "date-time"
    },
    "notAfter": {
      "type": "string",
      "format": "date-time"
    },
    "renewAfter": {
      "type": "string",
      "format": "date-time",
      "description": "RenewAfter is when the daemon should ask for the next certificate."
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "serverId",
    "certificate",
    "caCertificates",
    "notBefore",
    "notAfter",
    "renewAfter"
  ],
  "title": "ClientCertificate: signed response with the server's client certificate (mTLS, D50)",
  "description": "ClientCertificate is the signed response: the server's client certificate and the CA certificates it chains to."
}
